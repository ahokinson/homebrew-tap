#!/usr/bin/env zsh
# Update Casks/claude-code.rb to the latest upstream release.
#
# Fetches the version from the `latest` marker and per-arch SHA256
# checksums from `<version>/manifest.json`, then rewrites the three
# pinned lines in the cask. No-op if already current.

emulate -L zsh
setopt err_exit err_return no_unset pipe_fail

BUCKET="https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases"
CASK=${0:A:h:h}/Casks/claude-code.rb

die() { print -u2 -- "bump-claude-code: $*"; exit 1 }

(( $+commands[curl] )) || die "curl not found"
(( $+commands[jq]   )) || die "jq not found"
[[ -f $CASK ]]         || die "cask not found at $CASK"

upstream=${$(curl -fsSL "$BUCKET/latest")//[[:space:]]/}
[[ $upstream =~ '^[0-9]+(\.[0-9]+)+$' ]] || die "unexpected version: $upstream"

lines=("${(@f)$(<$CASK)}")
current=
for line in $lines; do
  [[ $line =~ '^  version "([^"]+)"$' ]] && { current=$match[1]; break }
done
[[ -n $current ]] || die "could not parse current version from $CASK"

if [[ $current == $upstream ]]; then
  print -- "claude-code is current at $current"
  exit 0
fi

manifest=$(curl -fsSL "$BUCKET/$upstream/manifest.json")
arm_sha=$(jq -er '.platforms["darwin-arm64"].checksum' <<<$manifest)
x64_sha=$(jq -er '.platforms["darwin-x64"].checksum'   <<<$manifest)

for sha in $arm_sha $x64_sha; do
  [[ $sha =~ '^[0-9a-f]{64}$' ]] || die "invalid sha: $sha"
done

# Walk the array, mutating the three pinned lines. `state` tracks whether
# the next sha256 line belongs to the arm or intel branch — anchored to the
# `on_arm do` / `on_intel do` line immediately above it in the cask.
state=
for i in {1..$#lines}; do
  case $lines[i] in
    '  version "'*'"')   lines[i]="  version \"$upstream\"" ;;
    '  on_arm do')       state=arm ;;
    '  on_intel do')     state=intel ;;
    '    sha256 "'*'"')
      case $state in
        arm)   lines[i]="    sha256 \"$arm_sha\""; state= ;;
        intel) lines[i]="    sha256 \"$x64_sha\""; state= ;;
      esac
      ;;
  esac
done

tmp=$CASK.tmp.$$
trap 'rm -f $tmp' EXIT
print -rl -- "${lines[@]}" >$tmp

for needle in "version \"$upstream\"" "sha256 \"$arm_sha\"" "sha256 \"$x64_sha\""; do
  grep -q -- "$needle" $tmp || exit 2
done

mv $tmp $CASK
trap - EXIT

print -- "bumped claude-code: $current -> $upstream"
print -- "  darwin-arm64 sha256: $arm_sha"
print -- "  darwin-x64   sha256: $x64_sha"
